{
  "name": "acfb-ai-studio",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://github.com/Karsten-Zhou/acfb-ai-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Karsten-Zhou/acfb-ai-studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typegen": "wrangler types server/worker-configuration.d.ts",
    "test": "vitest run",
    "typecheck": "run-p -c typecheck:app typecheck:server typecheck:node",
    "typecheck:app": "vue-tsc --build --force tsconfig.app.json",
    "typecheck:server": "tsc --build --force tsconfig.server.json",
    "typecheck:node": "tsc --build --force tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "sync-cf-model-list": "bun scripts/sync-cloudflare-models.ts",
    "sync-shiki-themes": "bun scripts/sync-shiki-themes.ts"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@hono/zod-validator": "^0.9.1",
    "@lucide/vue": "^1.52.0",
    "@tanstack/vue-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "jsonc-parser": "^3.3.1",
    "npm-run-all2": "^9.0.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
